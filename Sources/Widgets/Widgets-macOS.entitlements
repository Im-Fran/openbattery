<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- A widget extension on the Mac must be sandboxed, unlike the app. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Where the app leaves the device list for the widgets to read. A
	     group.-prefixed group needs a provisioning profile that grants it. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.cl.franciscosolis.openbattery</string>
	</array>
</dict>
</plist>
