<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The App Store requires the sandbox. Nothing else is needed: the app only
	     reads the IORegistry, opens System Settings and registers itself as a
	     login item, and all three work sandboxed. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
