# Signing material lives encrypted in a private repo, so a new machine or a CI
# runner can sign without anyone exporting a .p12 by hand.
git_url(ENV["MATCH_REPOSITORY_URL"])
storage_mode("git")

platform("macos")
app_identifier(["cl.franciscosolis.openbattery"])
# The iOS app shares this App ID but signs automatically in Xcode, so match
# only manages the macOS profiles. The Mac profiles must include the iCloud container
# iCloud.cl.franciscosolis.openbattery; see docs/icloud-setup.md.
