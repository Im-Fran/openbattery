# Copy to fastlane/.env and fill in. Never commit the filled copy.
#
# App Store Connect API key — drives match, notarization and App Store uploads.
# The .p8 itself is not stored here: put it in
# ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8
ASC_KEY_ID=
ASC_ISSUER_ID=

# Passphrase that decrypts the match repo. On the machine that created it, read
# it from the login keychain instead of pasting it here:
#   security find-generic-password -s fastlane-match-openbattery -w
MATCH_PASSWORD=
