# OpenBattery — build and test the macOS menu bar app.
#
# The Xcode project is generated from project.yml by XcodeGen and is not
# committed, so every lane regenerates it first.
# Pass signed:false where no signing certificate exists (CI).

ROOT = File.expand_path("..", __dir__)
PROJECT = "OpenBattery.xcodeproj"
SCHEME = "OpenBattery"
BUILD_DIR = "build"

# Keep the match passphrase out of any file on disk: on the machine that created
# it, it comes from the login keychain. CI passes MATCH_PASSWORD as a secret.
if ENV["MATCH_PASSWORD"].to_s.empty?
  keychain_password = `security find-generic-password -s fastlane-match-openbattery -w 2>/dev/null`.strip
  ENV["MATCH_PASSWORD"] = keychain_password unless keychain_password.empty?
end

default_platform(:mac)

platform :mac do
  before_all do
    # A throwaway keychain on CI: match has nowhere to put certificates
    # otherwise, and the runner's login keychain is locked.
    setup_ci if is_ci
    sh("xcodegen", "generate", "--spec", "#{ROOT}/project.yml", "--project", ROOT)
  end

  # One App Store Connect key drives match, notarization and uploads alike.
  # Locally it is the .p8 on disk; CI passes the same key as a secret.
  private_lane :api_key do
    key_id = ENV.fetch("ASC_KEY_ID")
    key_content = ENV["ASC_KEY_CONTENT"]

    if key_content.to_s.empty?
      app_store_connect_api_key(
        key_id: key_id,
        issuer_id: ENV.fetch("ASC_ISSUER_ID"),
        key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8")
      )
    else
      app_store_connect_api_key(
        key_id: key_id,
        issuer_id: ENV.fetch("ASC_ISSUER_ID"),
        key_content: key_content,
        is_key_content_base64: true
      )
    end
  end

  desc "Sync signing certificates and profiles from the match repo"
  lane :certificates do |options|
    key = api_key
    # Creating material is a local, deliberate act; CI only ever consumes it.
    readonly = options.fetch(:readonly, is_ci)

    # No "development" type: a Mac development profile needs registered devices,
    # and the app signs locally with a plain Apple Development identity anyway.
    match(
      type: "appstore",
      api_key: key,
      readonly: readonly,
      additional_cert_types: ["mac_installer_distribution"]
    )

    # The Developer ID *certificate* cannot be created through the App Store
    # Connect API — Apple restricts that to the Account Holder signed in
    # interactively. It is created once in Xcode and pushed into the match repo
    # with `bundle exec fastlane match import --type developer_id`; its profile
    # is ordinary and match manages it like any other.
    match(type: "developer_id", api_key: key, readonly: readonly)
  end

  desc "Run the unit tests"
  lane :test do |options|
    run_tests(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Debug",
      derived_data_path: "#{BUILD_DIR}/DerivedData",
      output_directory: "#{BUILD_DIR}/test_output",
      output_types: "junit",
      xcargs: options[:signed] == false ? "CODE_SIGNING_ALLOWED=NO" : nil
    )
  end

  desc "Build a Release OpenBattery.app into build/"
  lane :build do |options|
    build_mac_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: options.fetch(:export_method, "mac-application"),
      codesigning_identity: options[:codesigning_identity],
      export_options: options[:export_options],
      skip_package_pkg: options.fetch(:package_pkg, false) == false,
      skip_codesigning: options[:signed] == false,
      derived_data_path: "#{BUILD_DIR}/DerivedData",
      output_directory: BUILD_DIR,
      archive_path: "#{BUILD_DIR}/OpenBattery.xcarchive",
      xcargs: build_xcargs(options)
    )
  end

  desc "Package the already-built app into a DMG, without notarizing"
  lane :dmg do
    app = "#{BUILD_DIR}/OpenBattery.app"
    UI.user_error!("build first: no #{app}") unless File.exist?(File.join(ROOT, app))
    UI.success("Packaged #{package_dmg(app)}")
  end

  # The lane CI runs for every tag: App Store signing, TestFlight, nothing
  # further. The build waits there until someone promotes it, so no tag can
  # ship a version on its own.
  desc "Build and upload a TestFlight build to App Store Connect"
  lane :release_appstore do |options|
    key = api_key
    match(
      type: "appstore",
      api_key: key,
      readonly: true,
      additional_cert_types: ["mac_installer_distribution"]
    )

    # On macOS the profile is embedded while archiving, not while exporting, so
    # the export mapping alone leaves the app without one.
    profile = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING].values.first

    build(
      export_method: "app-store",
      codesigning_identity: "Apple Distribution",
      package_pkg: true,
      profile: profile,
      version: options[:version],
      build_number: options[:build_number],
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING],
        installerSigningCertificate: "3rd Party Mac Developer Installer"
      }
    )

    pkg = lane_context[SharedValues::PKG_OUTPUT_PATH]
    UI.user_error!("no .pkg was produced") if pkg.nil?
    # App Store Connect rejects a build without one, and it is the part most
    # easily lost: verify here rather than after a failed upload.
    unless File.exist?(File.join(ROOT, BUILD_DIR, "OpenBattery.app/Contents/embedded.provisionprofile"))
      UI.user_error!("the exported app has no embedded.provisionprofile")
    end

    if options[:upload] == false
      UI.success("Built #{pkg} — upload skipped")
    else
      upload_to_testflight(
        pkg: pkg,
        api_key: key,
        # The build takes minutes to process on Apple's side and nothing here
        # depends on the outcome.
        skip_waiting_for_build_processing: true
      )
    end
    pkg
  end

  desc "Build, notarize and package the DMG that ships on GitHub"
  lane :release_github do |options|
    key = api_key
    match(type: "developer_id", api_key: key, readonly: true)

    app = build(
      export_method: "developer-id",
      codesigning_identity: "Developer ID Application",
      version: options[:version],
      build_number: options[:build_number]
    )

    # Notarize the app first so the ticket is stapled into what people actually
    # run, then the disk image they download. Stapling both is what keeps a
    # first launch working offline.
    notarize(package: app, api_key: key, print_log: true)
    dmg = package_dmg(app)
    notarize(package: dmg, api_key: key, print_log: true)

    UI.success("Notarized #{dmg}")
    dmg
  end
end

# dmgbuild writes the image's .DS_Store directly. The Finder route — AppleScript
# setting `background picture` — is accepted and silently dropped on current
# macOS, so nothing but the icon positions ever reached the image.
VOLUME = "OpenBattery"
DMGBUILD_VERSION = "1.6.7"

# A tag like 1.2.0+7 carries both version fields; with no tag, whatever
# project.yml says stands.
def build_xcargs(options)
  args = []
  args << "CODE_SIGNING_ALLOWED=NO" if options[:signed] == false
  args << "MARKETING_VERSION=#{options[:version]}" if options[:version]
  args << "CURRENT_PROJECT_VERSION=#{options[:build_number]}" if options[:build_number]
  args << "PROVISIONING_PROFILE_SPECIFIER='#{options[:profile]}'" if options[:profile]
  args.join(" ") unless args.empty?
end

def package_dmg(app)
  app_abs = File.expand_path(app, ROOT)
  version = `plutil -extract CFBundleShortVersionString raw -o - "#{app_abs}/Contents/Info.plist"`.strip
  UI.user_error!("no CFBundleShortVersionString in #{app_abs}") if version.empty?

  dmg = File.join(ROOT, BUILD_DIR, "OpenBattery-#{version}.dmg")
  FileUtils.rm_f(dmg)

  # uvx runs dmgbuild without installing anything permanently; the version is
  # pinned so a release is reproducible.
  sh("uvx", "dmgbuild@#{DMGBUILD_VERSION}",
     # No @2x hunt: pairing one would produce an uncompressed TIFF, tens of
     # megabytes at this canvas size, where the PNG costs a few hundred KB.
     "--no-hidpi",
     "-s", File.join(ROOT, "packaging", "dmg-settings.py"),
     "-D", "app=#{app_abs}",
     "-D", "background=#{File.join(ROOT, 'packaging', 'dmg-background.png')}",
     VOLUME, dmg)

  sh("codesign", "--sign", "Developer ID Application", "--timestamp", dmg)
  dmg
end
